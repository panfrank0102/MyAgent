<Window x:Class="MyAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MyAgent.App.ViewModels"
        xmlns:conv="clr-namespace:MyAgent.App.Converters"
        xmlns:views="clr-namespace:MyAgent.App.Views"
        mc:Ignorable="d"
        Title="角色扮演聊天 Agent —— WPF Shell（假数据演示）"
        Height="720" Width="1120" MinHeight="480" MinWidth="800"
        Background="White"
        Loaded="Window_Loaded">
  <Window.Resources>
    <!-- bool → 可见性 -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <!-- 会话列表项样式：自绘模板去掉系统高亮，统一浅色（保持轻量，不引入第三方 UI 框架） -->
    <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="4,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 会话条目模板：常态显示名称/条数/时间；悬停出现“改名/清空/删除”；改名时内联编辑框 -->
    <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
      <Grid x:Name="SessionRow">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 常态显示 -->
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Text="{Binding CountDisplay}" FontSize="11" Foreground="#6B7280"/>
            <TextBlock Text="{Binding TimeDisplay}" FontSize="11" Foreground="#9CA3AF" Margin="10,0,0,0"/>
          </StackPanel>
        </StackPanel>

        <!-- 改名编辑框：出现即获焦点（FocusBehavior）；Enter 提交 / Esc 取消 -->
        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}"
                 views:FocusBehavior.FocusOnVisible="True"
                 FontSize="13" Padding="2">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}"/>
            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
          </TextBox.InputBindings>
        </TextBox>

        <!-- 悬停操作按钮（改名期间隐藏，避免与编辑框抢焦点） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=SessionRow}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Button Content="改名" Command="{Binding StartRenameCommand}" FontSize="10" Padding="5,2" Margin="0,0,4,0"/>
          <Button Content="清空" Command="{Binding ClearCommand}" FontSize="10" Padding="5,2" Margin="0,0,4,0"/>
          <Button Content="删除" Command="{Binding DeleteCommand}" FontSize="10" Padding="5,2"/>
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- 消息操作按钮：气泡底部常驻的轻量按钮（无边框/透明底，v0.5②）。
         Foreground 按角色区分：assistant 深灰（浅灰气泡上可读）、user 近白（蓝底可读）。 -->
    <Style x:Key="MessageActionButton" TargetType="Button">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#22000000"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#33000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsUser}" Value="True">
          <Setter Property="Foreground" Value="#EFF6FF"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- 消息模板：user 右侧蓝色气泡 / assistant 左侧灰色气泡；
         操作行常驻气泡底部（v0.5②，不依赖鼠标悬停）；气泡下世界书命中小字；纯文本保留换行 -->
    <DataTemplate DataType="{x:Type vm:MessageItemViewModel}">
      <Grid Margin="0,3">
        <StackPanel MaxWidth="640">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                  <Setter Property="HorizontalAlignment" Value="Right"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>

          <!-- 气泡：纯文本 + 保留换行；AI 流式增长由 Content 属性变更驱动；
               interrupted 消息的“（已停止）”已拼入 DisplayText；
               v0.5②：操作行常驻气泡底部，可见性只由 CanXxx 决定（不再依赖鼠标悬停） -->
          <Border CornerRadius="10" Padding="10,8" MaxWidth="560">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="#F3F4F6"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="14" LineHeight="21">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#1F2937"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- 操作行：常驻气泡底部；HasActions=false 时整行隐藏，不在气泡底部留空白 -->
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                          Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUser}" Value="True">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <Button Content="重新生成" Command="{Binding RegenerateCommand}"
                        Style="{StaticResource MessageActionButton}"
                        Visibility="{Binding CanRegenerate, Converter={StaticResource BoolToVis}}"
                        ToolTip="删除当前回复后按现有历史重新生成（仅最后一条 AI 回复可用）"/>
                <Button Content="重试" Command="{Binding RetryCommand}"
                        Style="{StaticResource MessageActionButton}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                        ToolTip="上次生成失败：以该用户消息重新生成"/>
                <Button Content="删除" Command="{Binding DeleteCommand}"
                        Style="{StaticResource MessageActionButton}" Margin="0"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                        ToolTip="删除此消息及其后所有消息（需确认）"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 世界书命中小字：无命中（HitText=null）时整行隐藏（§8） -->
          <TextBlock Text="{Binding HitText}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="4,3,0,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HitText}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- 主布局：左栏会话列表 ｜ 右栏（聊天头 + 聊天区 + 错误条 + 底部输入框） -->
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- 左栏：会话列表（§8：左侧会话列表） -->
    <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="#F9FAFB">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
          <TextBlock Text="会话" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          <Button Content="＋ 新建" Command="{Binding NewSessionCommand}" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource SessionItemStyle}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      </Grid>
    </Border>

    <!-- 右栏 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 聊天头：会话名 + 生成中指示 + 消息数 -->
      <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Background="White">
        <DockPanel Margin="16,11">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <!-- v0.6 入口：全局设置（模型预设等全局参数），无需选中会话 -->
            <Button Content="全局设置" Click="OpenGlobalSettings_Click"
                    Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                    ToolTip="全局设置：管理模型预设（Base URL / API Key / 模型名 / 推理强度），供所有会话选择"/>
            <!-- Step 12 入口：作用于当前选中会话；无选中时禁用（HasSession） -->
            <Button Content="会话设置" Click="OpenSettings_Click" IsEnabled="{Binding HasSession}"
                    Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center"
                    ToolTip="编辑当前会话的系统提示词、模型预设、预算与代理；无选中会话时不可用"/>
            <TextBlock Text="生成中…" Foreground="#2563EB" FontSize="12"
                       Visibility="{Binding SelectedSession.IsGenerating, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
            <TextBlock Text="{Binding SelectedSession.CountDisplay}" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding SelectedSession.Name, FallbackValue=未选择会话}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- 聊天区：ScrollViewer + ItemsControl（自动滚底逻辑在代码后置，属视图行为） -->
      <Grid Grid.Row="1">
        <ScrollViewer x:Name="MessageScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16,12"
                      ScrollChanged="MessageScroll_ScrollChanged">
          <ItemsControl ItemsSource="{Binding Messages}"/>
        </ScrollViewer>

        <!-- 空状态提示：未选会话或所选会话无消息时覆盖显示 -->
        <Border Background="#FAFAFA" Visibility="{Binding ShowEmptyChatHint, Converter={StaticResource BoolToVis}}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="选择或“＋ 新建”一个会话开始聊天" FontSize="15" Foreground="#6B7280" HorizontalAlignment="Center"/>
            <TextBlock Text="（假数据演示：选择“示例：王城历险”可查看气泡、世界书命中小字与“（已停止）”标注）"
                       FontSize="12" Foreground="#9CA3AF" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="440"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 消息级错误条（§10：请求失败统一错误条，不弹裸异常） -->
      <Border Grid.Row="2" Background="#FEE2E2" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
        <DockPanel Margin="16,8">
          <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissErrorCommand}" Padding="6,0" FontSize="12"/>
          <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- 底部输入区：Enter 发送 / Shift+Enter 换行（手势在代码后置 PreviewKeyDown）；
           生成中按钮变“停止”（红色）；全空白禁用发送（CanExecute） -->
      <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="White">
        <StackPanel Margin="12,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox"
                     Text="{Binding SelectedSession.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8,6"
                     FontSize="14"
                     PreviewKeyDown="InputBox_PreviewKeyDown">
              <TextBox.Style>
                <Style TargetType="TextBox">
                  <Style.Triggers>
                    <!-- 未选择会话时禁用输入 -->
                    <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBox.Style>
            </TextBox>
            <Button Grid.Column="1" Command="{Binding SendOrStopCommand}" MinWidth="92" Margin="10,0,0,0" FontSize="14">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Content" Value="发送"/>
                  <Setter Property="Background" Value="#3B82F6"/>
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="Padding" Value="14,0"/>
                  <Style.Triggers>
                    <!-- 生成中：按钮文案与颜色切换为“停止” -->
                    <DataTrigger Binding="{Binding SelectedSession.IsGenerating}" Value="True">
                      <Setter Property="Content" Value="停止"/>
                      <Setter Property="Background" Value="#DC2626"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </Grid>
          <TextBlock Text="Enter 发送 · Shift+Enter 换行 · 生成中按钮变为“停止” · 输入包含“模拟失败”可演示失败与“重试”"
                     FontSize="11" Foreground="#9CA3AF" Margin="2,4,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
