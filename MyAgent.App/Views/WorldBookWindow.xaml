<Window x:Class="MyAgent.App.Views.WorldBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyAgent.App.ViewModels"
        xmlns:conv="clr-namespace:MyAgent.App.Converters"
        Title="世界书编辑器" Height="680" Width="1000" MinHeight="500" MinWidth="820"
        Background="White"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#9CA3AF"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- 左列表条目：启用勾选 + 名称 + 关键词摘要（条目字段在右侧编辑区修改） -->
    <DataTemplate DataType="{x:Type vm:WorldBookItemViewModel}">
      <Grid Margin="2,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                  VerticalAlignment="Top" Margin="0,2,6,0"
                  ToolTip="启用/停用该条目（直接保存生效）"/>
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding KeywordSummary}" FontSize="11" Foreground="#6B7280"
                     TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,11">
        <Button DockPanel.Dock="Right" Content="关闭" Click="Close_Click" Padding="14,5" VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="世界书编辑器（每会话独立）" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="条目按 sort_order 顺序注入；启停、排序、新建、删除均实时保存到当前会话。"
                     FontSize="11" Foreground="#6B7280" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- 错误条（§10：请求失败统一错误条，不弹裸异常） -->
    <Border Grid.Row="1" Background="#FEE2E2" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
      <DockPanel Margin="16,8">
        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissErrorCommand}" Padding="6,0" FontSize="12"/>
        <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- 主体：左列表 ｜ 右编辑区 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="340"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左：搜索 + 条目列表 + 排序/增删 -->
      <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0" Background="#F9FAFB">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   Padding="6,4" FontSize="13" ToolTip="按条目名称或关键词子串过滤（ASCII 忽略大小写）"/>
          <TextBlock Grid.Row="1" Text="按名称 / 关键词过滤" Style="{StaticResource HintText}" Margin="0,3,0,6"/>

          <ListBox Grid.Row="2" ItemsSource="{Binding Entries}"
                   SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                   BorderThickness="0" Background="Transparent"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="新建" Command="{Binding NewEntryCommand}" Padding="10,4" Margin="0,0,6,0"
                    ToolTip="清空右侧编辑区，填写后保存为新条目"/>
            <Button Content="上移" Command="{Binding MoveUpCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="下移" Command="{Binding MoveDownCommand}" Padding="10,4" Margin="0,0,6,0"/>
            <Button Content="删除" Command="{Binding DeleteEntryCommand}" Padding="10,4"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 右：条目编辑区 -->
      <Grid Grid.Column="1" Margin="16,12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 编辑标题 + 当前条目提示 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
          <TextBlock Text="{Binding EditorTitle}" FontSize="14" FontWeight="Bold"/>
          <TextBlock Text="新建条目：填写后点“保存条目”；选择左侧条目可编辑其名称/关键词/内容。"
                     Style="{StaticResource HintText}"/>
        </StackPanel>

        <!-- 名称 -->
        <StackPanel Grid.Row="1">
          <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
          <TextBox Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" FontSize="13"/>
        </StackPanel>

        <!-- 关键词（一行一个，实时清洗） -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
          <TextBlock Text="关键词（一行一个）" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="KeywordsBox" Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" Height="82" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Padding="6,4" FontSize="13" LostFocus="KeywordsBox_LostFocus"/>
          <TextBlock Text="{Binding KeywordCountText}" Style="{StaticResource HintText}"/>
          <TextBlock Text="{Binding KeywordsPreview}" Style="{StaticResource HintText}" Foreground="#6B7280"/>
        </StackPanel>

        <!-- 内容（必填） -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="内容（必填）" Style="{StaticResource FieldLabel}"/>
          <TextBox Grid.Row="1" Text="{Binding ContentText, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Padding="6,4" FontSize="13" MinHeight="140"/>
        </Grid>

        <!-- 保存 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
          <Button DockPanel.Dock="Right" Content="保存条目" Command="{Binding SaveEntryCommand}"
                  Padding="18,5" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding EditorValidationText}" Foreground="#B45309"
                     VerticalAlignment="Center"
                     Visibility="{Binding ShowEditorValidation, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
      </Grid>
    </Grid>

    <!-- 成功提示条 -->
    <Border Grid.Row="3" Background="#ECFDF5" Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding StatusText}" Foreground="#047857" TextWrapping="Wrap" Margin="16,7"/>
    </Border>
  </Grid>
</Window>
