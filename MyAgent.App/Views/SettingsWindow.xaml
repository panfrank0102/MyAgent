<Window x:Class="MyAgent.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MyAgent.App.Converters"
        Title="会话设置" Height="780" Width="680" MinHeight="560" MinWidth="560"
        Background="White"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
  <Window.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#374151"/>
      <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="#9CA3AF"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
      <StackPanel Margin="18,12">
        <TextBlock Text="会话设置" FontSize="17" FontWeight="Bold"/>
        <TextBlock Text="配置仅作用于当前会话（每会话独立）；保存时整表提交，API Key 未改动则不更新。"
                   FontSize="11" Foreground="#6B7280" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- 错误条（§10：请求失败统一错误条，不弹裸异常） -->
    <Border Grid.Row="1" Background="#FEE2E2" Visibility="{Binding ShowError, Converter={StaticResource BoolToVis}}">
      <DockPanel Margin="16,8">
        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DismissErrorCommand}" Padding="6,0" FontSize="12"/>
        <TextBlock Text="{Binding ErrorText}" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- 表单 -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,14">
      <StackPanel>
        <!-- 会话名 -->
        <TextBlock Text="会话名" Style="{StaticResource FieldLabel}"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>

        <!-- 系统提示词 -->
        <TextBlock Text="系统提示词" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource FieldBox}" AcceptsReturn="True" Height="88"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="作为前置 system 消息拼接在本会话每轮请求最前面（多行）。" Style="{StaticResource HintText}"/>

        <!-- 扫描轮数 + 世界书开关 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="世界书扫描轮数" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ScanRoundsText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource FieldBox}" Width="140" HorizontalAlignment="Left"/>
            <TextBlock Text="扫描最近 N 轮历史 + 当前输入；0 = 只扫当前输入。" Style="{StaticResource HintText}"/>
          </StackPanel>
          <CheckBox Grid.Column="1" Content="启用世界书" IsChecked="{Binding WorldbookEnabled}"
                    VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                    ToolTip="关闭后本会话不注入世界书；仍可从下方“世界书编辑”进入编辑条目"/>
        </Grid>

        <!-- Base URL -->
        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        <TextBlock Text="OpenAI 兼容接口地址，如 https://api.openai.com/v1；留空 = 清除配置。" Style="{StaticResource HintText}"/>

        <!-- API Key（密码框，回显打码值） -->
        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
        <PasswordBox x:Name="ApiKeyBox" Padding="6,4" FontSize="13" PasswordChanged="ApiKeyBox_PasswordChanged"
                     ToolTip="打开时回显打码值；不修改则保存时不更新 Key"/>
        <TextBlock Text="回显为打码值；未修改或留空 = 不更新 API Key（服务端仅保存非空值）。"
                   Style="{StaticResource HintText}"/>

        <!-- 模型名 -->
        <TextBlock Text="模型名" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
        <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        <TextBlock Text="例如 gpt-4o-mini；留空 = 清除配置。" Style="{StaticResource HintText}"/>

        <!-- 采样参数 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="temperature（0~2）" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding TemperatureText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="角色扮演常见 0.7~1.2。" Style="{StaticResource HintText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="top_p（0~2）" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding TopPText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="核采样；默认 1.0。" Style="{StaticResource HintText}"/>
          </StackPanel>
        </Grid>

        <!-- 预算参数 -->
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="max_tokens" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MaxTokensText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="留空 = 上游默认（保存时清除该配置）。" Style="{StaticResource HintText}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="max_context_chars" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MaxContextCharsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
            <TextBlock Text="留空 = 不修改。" Style="{StaticResource HintText}"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="建议 80000：面向 100K 上下文模型（中文≈1 字符/token、ASCII≈4 字符/token），为输出与估算误差预留约 20% 余量；0 = 不裁剪。"
                   Style="{StaticResource HintText}"/>

        <!-- 代理 -->
        <TextBlock Text="proxy_url" Style="{StaticResource FieldLabel}" Margin="0,12,0,3"/>
        <TextBox Text="{Binding ProxyUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"/>
        <TextBlock Text="留空 = 直连；仅支持 http:// 或 https://，如 http://127.0.0.1:7890。" Style="{StaticResource HintText}"/>

        <!-- 测试连接 -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button Content="测试连接" Command="{Binding TestConnectionCommand}" Padding="14,5" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding TestResultText}" VerticalAlignment="Center" Margin="12,0,0,0"
                     TextWrapping="Wrap" MaxWidth="420">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#B91C1C"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding TestResultOk}" Value="True">
                    <Setter Property="Foreground" Value="#047857"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Text="测试使用当前表单值；API Key 未修改时以空 Key 探测（本地模型/直连可用，需验证鉴权请重新输入完整 Key）。"
                   Style="{StaticResource HintText}"/>
      </StackPanel>
    </ScrollViewer>

    <!-- 成功提示条 -->
    <Border Grid.Row="3" Background="#ECFDF5" Visibility="{Binding ShowStatus, Converter={StaticResource BoolToVis}}">
      <TextBlock Text="{Binding StatusText}" Foreground="#047857" TextWrapping="Wrap" Margin="18,7"/>
    </Border>

    <!-- 底部按钮区 -->
    <Border Grid.Row="4" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Background="#F9FAFB">
      <DockPanel Margin="18,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="世界书编辑" Click="OpenWorldBook_Click" Padding="12,5" Margin="0,0,8,0"
                  ToolTip="编辑当前会话的世界书条目（世界书开关关闭时也可进入）"/>
          <Button Content="保存" Command="{Binding SaveCommand}" Padding="18,5" Margin="0,0,8,0" FontWeight="SemiBold"/>
          <Button Content="关闭" Click="Close_Click" Padding="14,5"/>
        </StackPanel>
        <TextBlock Text="{Binding ValidationText}" Foreground="#B45309" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0"
                   Visibility="{Binding ShowValidation, Converter={StaticResource BoolToVis}}"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
